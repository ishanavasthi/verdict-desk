# Copy to .env: `cp .env.example .env`. The defaults below work out of the box for local dev.

# ---- Postgres (docker-compose) ----
POSTGRES_USER=verdict
POSTGRES_PASSWORD=verdict
POSTGRES_DB=verdict
POSTGRES_PORT=5432

# ---- Prisma / API ----
# Must match the Postgres vars above. NOTE: the host:port here is NOT derived
# from POSTGRES_PORT — if you change that, change this line too.
DATABASE_URL="postgresql://verdict:verdict@localhost:5432/verdict?schema=public"
API_PORT=4000
# Secret for signing the JWT stored in the httpOnly auth cookie. Change for anything real.
JWT_SECRET="dev-insecure-change-me"
# Set to 1 wherever the app is served over HTTPS, so the auth cookie is only
# ever sent over TLS. Left 0 for local dev, which is plain HTTP.
COOKIE_SECURE=0

# ---- Web ----
# NOTE: Next.js only auto-loads apps/web/.env, so these two are read from the
# SHELL environment, not from this file. `make dev` exports them for you; if you
# start the web app by hand with a non-default API_PORT, export API_PROXY_TARGET
# in that shell or the rewrite silently keeps pointing at :4000.
WEB_PORT=3000
# Where the Next.js /api/* rewrite forwards to (the NestJS API).
API_PROXY_TARGET="http://localhost:4000"

# ---- Rate limits (per minute; all optional, these are the built-in defaults) ----
# Submissions/doubts are keyed by user id, login by client IP.
RATE_LIMIT_SUBMISSIONS_PER_MIN=30
RATE_LIMIT_DOUBTS_PER_MIN=30
RATE_LIMIT_LOGIN_PER_MIN=10

# ---- LLM (OpenAI-compatible; NVIDIA NIM by default) ----
# MOCK_LLM=1 makes every AI feature work with NO API key (returns canned valid JSON).
# Set MOCK_LLM=0 and provide LLM_API_KEY to make real calls to any OpenAI-compatible endpoint.
MOCK_LLM=1
LLM_BASE_URL="https://integrate.api.nvidia.com/v1"
LLM_API_KEY=""
LLM_MODEL="meta/llama-3.1-8b-instruct"
